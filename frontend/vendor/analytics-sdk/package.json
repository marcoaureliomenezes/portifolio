{
  "name": "@dadaia/analytics-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Anonymous analytics browser SDK for dadaia portfolio",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "size": "gzip -c dist/index.umd.cjs | wc -c"
  }
}
